# Required: NGC API key for pulling the training container
NGC_API_KEY=

# MLflow tracking server URL
MLFLOW_TRACKING_URI=http://localhost:5050

# Prefect API URL
PREFECT_API_URL=http://localhost:4200/api

# Triton server URL
TRITON_HTTP_URL=localhost:8000
TRITON_GRPC_URL=localhost:8001

# Pipeline data paths
DATA_ROOT=/home/ubuntu/fraud-detection-mlops/data/TabFormer
MODEL_OUTPUT_DIR=/home/ubuntu/fraud-detection-mlops/data/trained_models
TRITON_MODEL_REPO=/home/ubuntu/fraud-detection-mlops/data/models

# Docker-compose volume paths (for services)
MLFLOW_DATA_DIR=./mlflow-data
PREFECT_DATA_DIR=./prefect-data
TRITON_IMAGE=triton-fraud:latest
